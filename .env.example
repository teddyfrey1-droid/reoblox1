# LUMORA — example environment configuration.
# Copy to .env for local development (the real .env is git-ignored).

# HTTP port for the dev server (API + web prototype)
PORT=8787

# Auth: stable HMAC signing key so session tokens survive restarts (random if unset).
# JWT_SIGNING_KEY=change-me-32-bytes-hex

# Enables the `test` IAP provider (HMAC-signed receipts) for local/dev redeem testing.
# Leave UNSET in production (real purchases use the apple/google/stripe verifiers).
# IAP_TEST_SECRET=

# --- Production placeholders ---
# DATABASE_URL=postgres://user:pass@localhost:5432/lumora
# REDIS_URL=redis://localhost:6379
# STRIPE_SECRET_KEY=
# APPLE_IAP_SHARED_SECRET=
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
